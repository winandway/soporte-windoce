{
  "name": "bandeja-soporte",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.js --bundle --format=esm --platform=neutral --main-fields=module,main --minify --outfile=_worker.js",
    "test": "vitest run --coverage",
    "check": "node --check src/worker.js",
    "verify": "npm run build && npm run test && npm audit --audit-level=high && git diff --exit-code _worker.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
